# Copy to .env and replace every value. Generate keys with:  openssl rand -hex 24
CLOUDPULSE_ADMIN_KEY=change-me-admin
CLOUDPULSE_VIEWER_KEY=change-me-viewer
CLOUDPULSE_AGENT_KEY=change-me-agent

# --- optional ---
AWS_REGION=us-east-1
# CLOUDPULSE_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:cloudpulse-alerts
# CLOUDPULSE_MIN_THROUGHPUT_MBPS=5
# CLOUDPULSE_MAX_LATENCY_MS=1000
# CLOUDPULSE_MAX_RETRIES=3
# CLOUDPULSE_ALERT_COOLDOWN_S=300
# CLOUDPULSE_RETENTION_DAYS=90
# Prefer hashed keys in CLOUDPULSE_API_KEYS: run `cloudpulse genkey --role viewer`
